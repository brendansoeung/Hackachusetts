# Copy this file to .env (which git ignores) and paste your real key there.
# Get a free key at https://aistudio.google.com (use a personal Gmail).
# On Vercel, add the same values under Project > Settings > Environment Variables.
GEMINI_API_KEY=paste-your-key-here
# Optional: override the model. Defaults to gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest
